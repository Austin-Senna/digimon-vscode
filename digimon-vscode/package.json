{
  "name": "digimon-vscode",
  "displayName": "digimon-vscode",
  "description": "digimon buddy for your programming journey",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [ ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "digimonView.refreshStats",
        "title": "Refresh Digimon Stats",
        "icon": {
          "light": "resources/digivice.webp",
          "dark": "resources/digivice.webp"
        }
      },
      {
      "command": "digimon.feed",
      "title": "Eat",
      "icon": "$(heart)" 
    }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "Digimon-Buddy",
          "title": "Digimon Buddy",
          "icon": "resources/digivice.webp"
        }
      ],
      "panel": [
        {
          "id": "Digimon-Playground",
          "title": "Digimon Stats"
        }
      ]
    },
    "views": {
      "Digimon-Buddy": [
        {
          "id": "digivice",
          "name": "digivice",
          "type": "webview"
        },
        {
          "id": "digimonView",
          "name": "Digimon Stats",
          "type": "tree"
        }, 
        {
          "id": "digimonPlayground",
          "name": "Digimon Playground"
        }
      ]
    }
},
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.107.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.48.1",
    "eslint": "^9.39.1",
    "esbuild": "^0.27.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
